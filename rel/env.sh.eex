#!/bin/sh

# Name each node after its private IPv6 address on Fly, so DNSCluster (querying
# DNS_CLUSTER_QUERY, e.g. "<app>.internal") can connect the machines into one
# BEAM cluster. Elsewhere this file is a no-op and the release defaults apply.
if [ -n "$FLY_PRIVATE_IP" ]; then
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${FLY_APP_NAME}-${FLY_IMAGE_REF##*-}@${FLY_PRIVATE_IP}"
  export ECTO_IPV6="true"
  export DNS_CLUSTER_QUERY="${DNS_CLUSTER_QUERY:-${FLY_APP_NAME}.internal}"
fi
