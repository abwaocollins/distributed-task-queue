<header class="sticky top-0 z-30 border-b border-zinc-200 bg-zinc-50/90 px-4 backdrop-blur sm:px-6 lg:px-8 dark:border-zinc-800 dark:bg-zinc-950/90">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-6">
    <.link
      navigate={~p"/"}
      class="shrink-0 text-sm font-semibold text-zinc-900 dark:text-zinc-100"
    >
      dtq
    </.link>
    <nav aria-label="Console" class="-mx-1 flex min-w-0 flex-1 gap-1 overflow-x-auto text-sm">
      <.nav_link navigate={~p"/"} active={assigns[:nav] == :overview}>Overview</.nav_link>
      <.nav_link navigate={~p"/queues"} active={assigns[:nav] == :queues}>Queues</.nav_link>
      <.nav_link navigate={~p"/jobs"} active={assigns[:nav] == :jobs}>Jobs</.nav_link>
      <.nav_link navigate={~p"/dead-letter"} active={assigns[:nav] == :dead_letter}>
        Dead letter
        <span
          :if={(assigns[:dead_count] || 0) > 0}
          id="nav-dead-count"
          class="ml-1.5 rounded-full bg-rose-100 px-1.5 font-mono text-xs tabular-nums text-rose-700 dark:bg-rose-400/15 dark:text-rose-300"
        >
          {@dead_count}
        </span>
      </.nav_link>
      <.nav_link navigate={~p"/cron"} active={assigns[:nav] == :cron}>Cron</.nav_link>
    </nav>
    <div class="hidden shrink-0 items-center gap-4 text-sm text-zinc-500 md:flex dark:text-zinc-400">
      <a
        :if={Application.get_env(:distributed_task_queue, :dev_routes)}
        href="/dev/dashboard"
        class="hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        BEAM metrics
      </a>
      <a
        href="https://github.com/abwaocollins/distributed-task-queue"
        class="hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        Source
      </a>
    </div>
  </div>
</header>
<main class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
